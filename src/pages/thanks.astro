---
// Netlify redirects here after a successful contact-form submission
// (see action="/thanks/" in src/components/ContactForm.astro).
// Kept deliberately simple and not locale-routed — visitors only pass
// through it for a second after submitting.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thank you — NOVERA</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="flex min-h-screen items-center justify-center bg-warm-ivory px-6 text-center font-body text-graphite">
    <div>
      <p class="font-display text-2xl text-deep-eucalyptus">Merci — Thank you — Grazie — Gracias</p>
      <p class="mt-3 text-sm text-graphite/70">Your message has been sent. We'll be in touch shortly.</p>
      <a href="/fr/" class="mt-6 inline-block text-sm font-medium text-bronze hover:underline">← Retour au site / Back to site</a>
    </div>
  </body>
</html>
