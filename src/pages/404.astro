---
// A single, non-localized 404 page keeps this simple — visitors who hit
// a broken link get a way back into the site in any of the 4 languages.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page not found — NOVERA</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="flex min-h-screen items-center justify-center bg-warm-ivory px-6 text-center font-body text-graphite">
    <div>
      <p class="font-display text-3xl text-deep-eucalyptus">404</p>
      <p class="mt-3 text-sm text-graphite/70">Page not found.</p>
      <nav class="mt-6 flex justify-center gap-4 text-sm font-medium text-bronze">
        <a href="/fr/" class="hover:underline">Français</a>
        <a href="/en/" class="hover:underline">English</a>
        <a href="/it/" class="hover:underline">Italiano</a>
        <a href="/es/" class="hover:underline">Español</a>
      </nav>
    </div>
  </body>
</html>
