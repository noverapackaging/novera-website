---
import { LOCALES, LOCALE_LABELS, swapLocale, type Locale } from '../i18n/locales';

interface Props {
  currentLocale: Locale;
  currentPath: string;
  label: string;
}
const { currentLocale, currentPath, label } = Astro.props;
---

<nav aria-label={label} class="flex items-center gap-1 text-sm">
  {
    LOCALES.map((locale, i) => (
      <>
        {i > 0 && <span class="text-sand" aria-hidden="true">/</span>}
        <a
          href={swapLocale(currentPath, locale)}
          class:list={[
            'px-1.5 py-1 uppercase tracking-wide transition-colors',
            locale === currentLocale
              ? 'text-bronze font-medium'
              : 'text-warm-ivory/70 hover:text-warm-ivory',
          ]}
          aria-current={locale === currentLocale ? 'true' : undefined}
        >
          {locale}
        </a>
      </>
    ))
  }
</nav>
