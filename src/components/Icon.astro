---
// Small line-icon set used by the Values cards. Icons are chosen in the
// CMS by typing one of these names into the "icon" field.
interface Props {
  name: 'globe' | 'star' | 'bolt' | 'leaf';
  class?: string;
}
const { name, class: className = 'h-7 w-7' } = Astro.props;

const paths: Record<Props['name'], string> = {
  globe:
    'M12 21a9 9 0 100-18 9 9 0 000 18zM3 12h18M12 3c2.5 2.5 3.75 5.5 3.75 9s-1.25 6.5-3.75 9c-2.5-2.5-3.75-5.5-3.75-9S9.5 5.5 12 3z',
  star: 'M12 3l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6L12 3z',
  bolt: 'M13 2L4 14h6l-1 8 9-12h-6l1-8z',
  leaf: 'M5 21c9 0 14-5 14-14V5h-2C8 5 3 10 3 19v2h2zM5 21c4-4 8-8 14-14',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
